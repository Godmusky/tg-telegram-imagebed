# ==================== 服务器配置 ====================
# 监听端口（默认 18793）
# PORT=18793

# CORS 允许的域名（默认 *）
# ALLOWED_ORIGINS=*

# 日志级别（DEBUG/INFO/WARNING/ERROR，默认 INFO）
# LOG_LEVEL=INFO

# ==================== 代理（可选） ====================
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# ==================== 加密配置 ====================
# 加密密钥由 config.py 自动从 data/.secret_key 读取，无需额外配置

# ==================== Telegram Bot（必填） ====================
# 默认使用数据库配置；设置环境变量可覆盖
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# ==================== 存储配置 ====================
# 默认使用数据库配置；若使用 Telegram 后端需配置以下变量
# TELEGRAM_STORAGE_CHAT_ID=-1001234567890

# ==================== S3 后端（可选） ====================
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_REGION=auto
# S3_PUBLIC_URL_PREFIX=https://cdn.example.com

# ==================== 环境变量引用 ====================
# 数据库配置可通过 env: 前缀引用环境变量
# 例如 storage_config_json 中的 bot_token 可设为 "env:TELEGRAM_BOT_TOKEN"
